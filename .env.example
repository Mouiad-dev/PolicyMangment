# PolicyDesk environment variables — example file.
# Copy this to .env and fill in real values. Never commit .env.
# Nested keys use "__":  DB__POOL__SIZE  ->  settings.db.pool.size

# --- App ---
ENVIRONMENT=local            # local / test / staging / prod
DEBUG=true                   # docs pages are hidden in prod
LOG_LEVEL=DEBUG
SECRET_KEY=change-me         # secret; used for JWT later
CORS_ORIGINS=http://localhost:5173

# --- Database ---
DB__HOST=localhost
DB__PORT=5432
DB__NAME=policydesk
DB__USER=app
DB__PASSWORD=app             # secret
DB__DRIVER=postgresql+asyncpg
DB__POOL__SIZE=3             # check the pool budget (lesson 13)
DB__POOL__MAX_OVERFLOW=2
DB__POOL__TIMEOUT=10         # seconds
DB__POOL__RECYCLE=1800       # seconds
DB__STATEMENT_TIMEOUT_MS=10000
DB__IDLE_TX_TIMEOUT_MS=30000

# --- Mail (MailHog in dev) ---
MAIL__BACKEND=smtp           # smtp / console / fake
MAIL__HOST=mailhog
MAIL__PORT=1025

# --- Payments ---
PAYMENT__PROVIDER=fake       # fake / stripe
STRIPE__SECRET_KEY=sk_test_change_me     # secret; sk_live_ refused outside prod
STRIPE__WEBHOOK_SECRET=whsec_change_me   # secret; printed by `stripe listen`

# --- Docker (compose only): ports on your laptop ---
API_HOST_PORT=8000
DB_HOST_PORT=5432            # `just migrate` uses this (keep DB__PORT the same)
TEST_DB_HOST_PORT=5433       # tests use this (conftest reads it)
MAIL_SMTP_HOST_PORT=1025
MAIL_UI_HOST_PORT=8025       # inbox: http://localhost:8025
