{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(alembic upgrade *)",
      "Bash(alembic downgrade *)",
      "Bash(rm *)",
      "Bash(docker compose down *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Edit(./.env)"
    ]
  }
}
